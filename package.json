{
  "name": "ontologize",
  "version": "0.3.0",
  "description": "Ontology processing utilities for JSON-LD and MongoDB",
  "main": "index.js",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    },
    "./server": {
      "import": "./src/OntologizeServer.js",
      "types": "./src/OntologizeServer.d.ts"
    },
    "./adapters": {
      "import": "./src/adapters/index.js"
    },
    "./http": {
      "import": "./src/adapters/httpCollectionHandler.js"
    },
    "./geo": {
      "import": "./src/geo/index.js"
    },
    "./geo-server": {
      "import": "./src/geo/server.js"
    },
    "./readme": {
      "import": "./readme.js"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "src/**/*"
  ],
  "scripts": {
    "test": "NODE_ENV=test mocha tests/**/*.test.js --timeout 10000",
    "test:watch": "NODE_ENV=test mocha tests/**/*.test.js --watch --timeout 10000",
    "build": "echo \"No build step needed - using source directly\""
  },
  "keywords": [
    "ontology",
    "json-ld",
    "mongodb",
    "owl",
    "rdf",
    "semantic-web",
    "bold"
  ],
  "author": "Anderson Wiese <anderson@2wav.io>",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/2wav/bold"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@date-fns/utc": "^2.1.1",
    "bold-ld": "file:../bold-ld",
    "chai": "^4.3.10",
    "date-fns": "^4.1.0",
    "h3-js": "^4.1.0",
    "lodash": "^4.17.21",
    "ngeohash": "^0.6.3",
    "sunrise-sunset-api": "^0.2.1"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "mocha": "^10.2.0"
  }
}
