{
  "name": "ontologize",
  "version": "0.1.0",
  "description": "Ontology processing utilities for JSON-LD and MongoDB",
  "main": "index.js",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    },
    "./server": {
      "import": "./src/ontologize-server.js",
      "types": "./src/ontologize-server.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "src/**/*"
  ],
  "scripts": {
    "test": "mocha tests/**/*.test.js --timeout 10000",
    "test:watch": "mocha tests/**/*.test.js --watch --timeout 10000",
    "build": "echo \"No build step needed - using source directly\""
  },
  "keywords": ["ontology", "json-ld", "mongodb", "owl", "rdf", "semantic-web", "bold"],
  "author": "Anderson Wiese <anderson@2wav.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2wav/bold"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "chai": "^4.3.10",
    "bold-ld": "file:../bold-ld"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10"
  }
}